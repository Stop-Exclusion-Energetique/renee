<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RollForward>Major</RollForward>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Set up the NuGet package to be an MCP server -->
		<PackAsTool>true</PackAsTool>
		<PackageType>McpServer</PackageType>

		<!-- Set recommended package metadata -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageId>Renee.McpServer</PackageId>
		<PackageVersion>0.1.0-beta</PackageVersion>
		<PackageTags>MCP; server</PackageTags>
		<Description>Serveur MCP de Renée : outils d'accès aux dossiers d'accompagnement, authentification par jeton JWT.</Description>
		<UserSecretsId>163d087a-8c29-402e-9890-f885094511ac</UserSecretsId>
	</PropertyGroup>

	<!-- Fichiers inclus dans le paquet. -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ModelContextProtocol" Version="1.4.1" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
		<PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/Renee.Domain/Renee.Domain.csproj" />
		<ProjectReference Include="../../src/Renee.Infrastructure/Renee.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Properties\" />
		<Folder Include="Services\" />
	</ItemGroup>

</Project>
