@using Renee.Application.DTOs.Administration
@using Renee.Domain.Entity
@using Renee.UI.Components.ErrorHandling
@attribute [Route(Endpoints.AnahCategory)]
@attribute [Authorize]


<AuthorizeView Context="_"
               Roles="@Constants.AdminRole">
    <Authorized>
        <ZeeHeader DisplayReturn="true"
                   ShouldRenderLogo="true"
                   Title="@Labels.AnahCategoryTitle">
        </ZeeHeader>
        <div class="d-flex flex-column my-2">
            <div class="my-3">

                <h2>@AnahTableLabels.AnahCategoriesInIleDeFrance</h2>

                <div class="space">
                    <ZeeButton disabled="@(_anahCategoryToInsert != null || _anahCategoryToUpdate != null)"
                               DisplayBackground="DisplayEnumBackground.Green"
                               Icon="add_circle_outline"
                               @onclick="@((async () => { await InsertRow(_anahCategoriesInIleDeFranceGrid); }))"
                               Text="@Labels.AddLine">
                    </ZeeButton>
                </div>

                <div class="space">
                    <ZeeDataGrid AllowAlternatingRows="false"
                                 AllowFiltering="true"
                                 AllowPaging="true"
                                 AllowSorting="true"
                                 Data="_anahCategoriesInIleDeFrance"
                                 EditMode="DataGridEditMode.Single"
                                 Filter="@Reset"
                                 Page="@Reset"
                                 PageSize="10"
                                 @ref="_anahCategoriesInIleDeFranceGrid"
                                 RowCreate="@OnCreateRow"
                                 RowUpdate="@OnUpdateRow"
                                 Sort="@Reset"
                                 TItem="AnahCategoryDto">
                        <Columns>
                            <RadzenDataGridColumn Property="Id"
                                                  TItem="AnahCategoryDto"
                                                  Visible="false">
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="PeopleNumber"
                                                  TItem="AnahCategoryDto"
                                                  HeaderCssClass="cells-style-green">
                                <HeaderTemplate>
                                    @AnahTableLabels.NumberOfPeopleInHousehold
                                </HeaderTemplate>
                                <Template Context="anahCategory">
                                    @anahCategory.PeopleNumber
                                </Template>
                                <EditTemplate Context="anahCategory">
                                    <OutlinedInt @bind-Intgr="@anahCategory.PeopleNumber"
                                                 Label="@Labels.PeopleNumber"
                                                 Type="OutlinedInt.TypeOfValue.Int">
                                    </OutlinedInt>
                                </EditTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="VeryLowIncomeHouseholdsAmount"
                                                  TItem="AnahCategoryDto"
                                                  HeaderCssClass="cells-style-blue">
                                <HeaderTemplate>
                                    @AnahTableLabels.VeryLowHouseholdIncome
                                </HeaderTemplate>
                                <Template Context="anahCategory">
                                    @anahCategory.VeryLowIncomeHouseholdsAmount.ToString()
                                </Template>
                                <EditTemplate Context="anahCategory">
                                    <OutlinedDouble @bind-Double="@anahCategory.VeryLowIncomeHouseholdsAmount"
                                                    Label="@Labels.VeryLowIncomeHouseholdsAmount"
                                                    Type="OutlinedDouble.TypeOfValue.Double">
                                    </OutlinedDouble>
                                </EditTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="LowIncomeHouseholdsAmount"
                                                  TItem="AnahCategoryDto"
                                                  HeaderCssClass="cells-style-yellow">
                                <HeaderTemplate>
                                    @AnahTableLabels.LowHouseholdIncome
                                </HeaderTemplate>
                                <Template Context="anahCategory">
                                    @anahCategory.LowIncomeHouseholdsAmount.ToString()
                                </Template>
                                <EditTemplate Context="anahCategory">
                                    <OutlinedDouble @bind-Double="@anahCategory.LowIncomeHouseholdsAmount"
                                                    Label="@Labels.LowIncomeHouseholdsAmount"
                                                    Type="OutlinedDouble.TypeOfValue.Double">
                                    </OutlinedDouble>
                                </EditTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AnahCategoryDto"
                                                  Property="RuleStartDate"
                                                  HeaderCssClass="cells-style">
                                <HeaderTemplate>
                                    @AnahTableLabels.AnahRulesStartDate
                                </HeaderTemplate>
                                <Template Context="anahCategory">
                                    @ConvertDateTimeToString(anahCategory.RuleStartDate)
                                </Template>
                                <EditTemplate Context="anahCategory">
                                    <label class="pure-material-textfield-outlined">
                                        <ZeeInputDate @bind-Value="anahCategory.RuleStartDate"
                                                   @bind-Value:format="yyyy-MM-dd" />
                                        <span>
                                            @AnahTableLabels.AnahRulesStartDate
                                        </span>
                                    </label>
                                </EditTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="AnahCategoryDto"
                                                  Property="RuleEndDate"
                                                  HeaderCssClass="cells-style">
                                <HeaderTemplate>
                                    @AnahTableLabels.AnahRulesEndDate
