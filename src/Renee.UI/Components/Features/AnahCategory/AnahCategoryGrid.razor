                                                  Filterable="false"
                                                  Sortable="false"
                                                  TextAlign="TextAlign.Right"
                                                  TItem="AnahCategoryDto"
                                                  Width="156px">
                                <Template Context="anahCategoryDto">
                                    <RadzenButton ButtonStyle="ButtonStyle.Light"
                                                  Click="@(async _ => await EditRow(_anahCategoriesInIleDeFranceGrid, anahCategoryDto))"
                                                  Icon="edit"
                                                  @onclick:stopPropagation="true"
                                                  Size="ButtonSize.Medium"
                                                  Variant="Variant.Flat">
                                    </RadzenButton>
                                </Template>
                                <EditTemplate Context="anahCategoryDto">
                                    <RadzenButton ButtonStyle="ButtonStyle.Success"
                                                  Click="@(async _ => await SaveRow(_anahCategoriesInIleDeFranceGrid, anahCategoryDto))"
                                                  Icon="check"
                                                  Size="ButtonSize.Medium"
                                                  Variant="Variant.Flat">
                                    </RadzenButton>
                                    <RadzenButton ButtonStyle="ButtonStyle.Light"
                                                  class="ms-1 my-1"
                                                  Click="@(_ => CancelEdit(_anahCategoriesInIleDeFranceGrid, anahCategoryDto))"
                                                  Icon="close"
                                                  Size="ButtonSize.Medium"
                                                  Variant="Variant.Flat">
                                    </RadzenButton>
                                </EditTemplate>
