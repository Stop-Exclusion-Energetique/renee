@using System.Globalization
@using Renee.UI.Components.Features.Index.Components
@attribute [Route(Endpoints.Base)]

@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        @if (ViewModel is not null)
        {
            <p class="h3">@ViewModel!.UserFullName</p>

            <p class="h1">@HeaderTitle</p>

            <div class="@(_userRole != Constants.AdminRole ? "filter-container" : "")">
                <div class="grid-filter-area">
                    <AuthorizeView Context="solidarbuildercontext"
                                   Roles=@($"{Constants.SolidarBuilderRole}")>
                        <div>
                            <ZeeSelect @bind-CheckedValue="FilterViewModel.FilterValue"
                                       @bind-CheckedValue:after="OnFilterChange"
                                       ElementName="@($"filterValue-{Guid.NewGuid().ToString()}")"
                                       IsMultiSelect="false"
                                       Items="@(SelectedFilter.ToList())" />
                        </div>
                    </AuthorizeView>

                    <AuthorizeView Context="assomembercontext" Roles="@Constants.AssociationMemberRole">
                        <div>
                            <ZeeSelect @bind-CheckedValues="@FilterViewModel.SelectedReportingStructures"
                                       ElementName="@($"reportingStructure-{Guid.NewGuid().ToString()}")"
                                       IsMultiSelect="true"
                                       Items="@ReportingStructures"
                                       Label="@IndexLabels.FilterByReportingStructures"
                                       OnNewValueSelected="@OnReportingStructuresChanged"
                                       ShowLabelBefore="false"
                                       TItem="Guid?"
                                       ShouldSort="true" />
                        </div>
                    </AuthorizeView>
                    <AuthorizeView Context="targetedCoordinatorContext" Roles="@Constants.TargetedCoordinatorRole">
                        <div class="zee-button">
                            <ZeeSelect @bind-CheckedValues="@FilterViewModel.SelectedTerritories"
                                       @bind-CheckedValues:after="@OnTerritoriesChanged"
                                       ElementName="@($"territory-{Guid.NewGuid().ToString()}")"
                                       IsMultiSelect="true"
                                       Items="@Territories"
                                       Label="@Labels.FilterByTerritory"
                                       TItem="Guid?"
                                       ShouldSort="true" />
                        </div>
                    </AuthorizeView>


                    <AuthorizeView Context="coordinatorcontext"
                                   Roles="@($"{Constants.TargetedCoordinatorRole}, {Constants.DiffuseCoordinatorRole}, {Constants.TerritorialBuilderRole}")">
                        <div>
                            <ZeeSelect @bind-CheckedValue="FilterViewModel.FilterValue"
                                       @bind-CheckedValue:after="OnFilterChange"
                                       ElementName="@($"filterValue-{Guid.NewGuid().ToString()}")"
                                       IsMultiSelect="false"
                                       Items="@(SelectedFilterCoordinatorAndTerritorialBuilder.ToList())" />
                        </div>
                        <div class="zee-button">
                            <ZeeSelect @bind-CheckedValues="@FilterViewModel.SelectedReportingStructures"
                                       @bind-CheckedValues:after="@OnReportingStructuresCoordinatorOrTerritorialBuilderChanged"
                                       ElementName="@($"reportingStructure-{Guid.NewGuid().ToString()}")"
                                       IsMultiSelect="true"
                                       Items="@ReportingStructures"
                                       Label="@Labels.FilterByReportingStructure"
                                       TItem="Guid?"
                                       ShouldSort="true" />
                        </div>
                        <div class="zee-button">
                            <ZeeSelect @bind-CheckedValues="@FilterViewModel.SelectedSolidarBuilder"
                                       ElementName="@($"solidarBuilder-{Guid.NewGuid().ToString()}")"
                                       IsMultiSelect="true"
                                       Items="@SolidarBuilders"
                                       Label="@Labels.FilterBySolidarBuilder"
                                       OnNewValueSelected="@OnSolidarBuilderChanged"
                                       TItem="Guid?"
                                       ShouldSort="true" />
                        </div>
                    </AuthorizeView>

                    <AuthorizeView Roles="@($"{Constants.TargetedCoordinatorRole}, {Constants.DiffuseCoordinatorRole}, {Constants.TerritorialBuilderRole}, {Constants.SolidarBuilderRole}, {Constants.StructuralReferentRole}")"
                                   Context="filterDateContext">
                        <div class="date-filter">
                            <div class="reset-filter"
                                 @onclick="ResetFilter">
                                <img src="@Icons.CancelFilter"
                                     alt="Annuler"
                                     width="30" />
                            </div>

                            <div class="d-flex flex-column date-field">
                                <label class="pure-material-textfield-outlined ">
                                    <ZeeInputDate @bind-Value="FilterViewModel.FromDate"
                                               @bind-Value:after="OnFilterChange"
                                               @bind-Value:format="yyyy-MM-dd"
                                               max="@(DateTime.Now.ToString("yyyy-MM-dd"))"
                                               min="@(new DateTime(1950, 01, 01, 0, 0, 0, DateTimeKind.Utc).ToString("yyyy-MM-dd"))" />

                                    <span>
                                        @IndexLabels.StartDate
                                    </span>
                                </label>
                            </div>

                            <div class="d-flex flex-column date-field">
                                <label class="pure-material-textfield-outlined ">
                                    <ZeeInputDate @bind-Value="FilterViewModel.ToDate"
                                               @bind-Value:after="OnFilterChange"
                                               @bind-Value:format="yyyy-MM-dd"
                                               max="@(DateTime.Now.ToString("yyyy-MM-dd"))"
                                               min="@(new DateTime(1950, 01, 01, 0, 0, 0, DateTimeKind.Utc).ToString("yyyy-MM-dd"))" />

                                    <span>
                                        @IndexLabels.EndDate
                                    </span>
                                </label>
                            </div>
                        </div>
                    </AuthorizeView>
                </div>

            </div>

            <AuthorizeView Context="solidarBuilder"
                           Roles=@($"{Constants.SolidarBuilderRole}, {Constants.StructuralReferentRole}")>
                <div class="grid">
                    <div class="card card-height text-alignement">
                        <h2>@IndexLabels.MilestoneDistribution</h2>

                        @if (Array.TrueForAll(ViewModel.AccompanyingFileStage, x => x.VerticalAxisValue <= 0))
                        {
                            <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                        }
                        else
                        {
                            <RadzenChart>

                                <RadzenColumnSeries CategoryProperty="Name"
                                                    Data="@ViewModel.AccompanyingFileStage"
                                                    Fills="@(new List<string> { "#429AD5", "orange", "grey" })"
                                                    ValueProperty="VerticalAxisValue">

                                    <TooltipTemplate Context="data">

                                        <div>
                                            <span>@data.Name</span> :
                                            <strong>@data.VerticalAxisValue</strong>
                                        </div>

                                    </TooltipTemplate>

                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="true" />
                                    </ChildContent>
                                </RadzenColumnSeries>

                                <RadzenColumnOptions Radius="5" Width="50" />

                                <RadzenValueAxis Min="0"
                                                 Step="1"
                                                 Visible="false">
                                </RadzenValueAxis>

                                <RadzenCategoryAxis Visible="false">
                                </RadzenCategoryAxis>

                                <RadzenLegend Visible="false" />
                            </RadzenChart>

                            <div>
                                <ZeeLegendElement Color="#429AD5"
                                                  Label="@IndexLabels.Identification" />
                                <ZeeLegendElement Color="orange"
                                                  Label="@IndexLabels.OrganizeAndFinance" />
                                <ZeeLegendElement Color="grey"
                                                  Label="@IndexLabels.RealizeAndFollow" />
                            </div>
                        }
                    </div>

                    <div class="card card-height text-alignement">
                        <h2>@IndexLabels.AnahCategoriesRepartition</h2>

                        @if (ViewModel.AnahCategoryRepartition[0].PieAxisValue <= 0 && ViewModel.AnahCategoryRepartition[1].PieAxisValue <= 0)
                        {
                            <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                        }
                        else
                        {
                            <RadzenChart>

                                <RadzenPieSeries CategoryProperty="Name"
                                                 Data="@ViewModel.AnahCategoryRepartition"
                                                 Fills="@(new List<string> { "#429AD5", "grey" })"
                                                 Title="@IndexLabels.PieChartTitle"
                                                 ValueProperty="PieAxisValue">

                                    <RadzenSeriesDataLabels Visible=true></RadzenSeriesDataLabels>

                                </RadzenPieSeries>

                                <RadzenValueAxis Formatter="@ToPercentageAnnahCategory"></RadzenValueAxis>

                                <RadzenLegend Visible="false" />

                            </RadzenChart>

                            <div>
                                <ZeeLegendElement Color="#429AD5"
                                                  Label="@Labels.LowIncomeHouseholdsAmount" />
                                <ZeeLegendElement Color="grey"
                                                  Label="@Labels.VeryLowIncomeHouseholdsAmount" />
                            </div>
                        }
                    </div>

                    <div class="card card-height text-alignement">
                        <h2>@IndexLabels.WorksFinancing</h2>

                        <div class="text-section-alignment">
                            <h3 class="average-money-text">@($"{ViewModel.EstimatedRemainingAmountAverage.ToString("C", CultureInfo.CreateSpecificCulture("fr-FR"))}")</h3>
                            <p>@IndexLabels.RemainingAmount</p>
                        </div>

                        <div class="text-section-alignment">
                            <h3 class="average-money-text">@($"{ViewModel.EstimatedWorkPackageCostAverage.ToString("C", CultureInfo.CreateSpecificCulture("fr-FR"))}")</h3>
                            <p>@IndexLabels.AverageWorksCost</p>
                        </div>
                    </div>

                    <div class="card card-height text-alignement">
                        <h2>@IndexLabels.NumberOfSupport</h2>

                        @if (Array.TrueForAll(ViewModel.AccompanyingFileStatus, x => x.HorizontalAxisValue <= 0))
                        {
                            <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                        }
                        else
                        {
                            <RadzenChart>
                                <RadzenColumnSeries CategoryProperty="Name"
                                                    Data="@ViewModel.AccompanyingFileStatus"
                                                    Fills="@(new List<string> { "#429AD5", "#071952" })"
                                                    Title="@IndexLabels.OnHold"
                                                    ValueProperty="HorizontalAxisValue">
                                    <TooltipTemplate Context="data">

                                        <div>
                                            <span>@data.Name</span> :
                                            <strong>@data.HorizontalAxisValue</strong>
                                        </div>

                                    </TooltipTemplate>

                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="true" />
                                    </ChildContent>
                                </RadzenColumnSeries>

                                <RadzenValueAxis Min="0"
                                                 Step="1"
                                                 Visible="false">
                                </RadzenValueAxis>

                                <RadzenCategoryAxis Visible="false">
                                </RadzenCategoryAxis>

                                <RadzenColumnOptions Radius="5" Width="50" />

                                <RadzenLegend Visible="false" />
                            </RadzenChart>

                            <div>
                                <ZeeLegendElement Color="#429AD5"
                                                  Label="@IndexLabels.OnHold" />
                                <ZeeLegendElement Color="#071952"
                                                  Label="@IndexLabels.Completed" />
                            </div>
                        }
                    </div>
                </div>
            </AuthorizeView>
            <AuthorizeView Context="associationMember" Roles="@Constants.AssociationMemberRole">
                <div class="grid">
                    <div class="card card-height text-alignement">
                        <h2>@IndexLabels.WorksFinancing</h2>
                        <div class="text-section-alignment">
                            <h3 class="average-money-text">@($"{ViewModel.EstimatedRemainingAmountAverage.ToString("C1", CultureInfo.CreateSpecificCulture("fr-FR"))}")</h3>
                            <p>@IndexLabels.RemainingAmount</p>
                        </div>
                        <div class="text-section-alignment">
                            <h3 class="average-money-text">@($"{ViewModel.EstimatedWorkPackageCostAverage.ToString("C1", CultureInfo.CreateSpecificCulture("fr-FR"))}")</h3>
                            <p>@IndexLabels.AverageWorksCost</p>
                        </div>
                    </div>
                    <div class="card card-height text-alignement">
                        <h2>@IndexLabels.NumberOfSupport</h2>
                        @if (Array.TrueForAll(ViewModel.AccompanyingFileStatus, x => x.HorizontalAxisValue <= 0))
                        {
                            <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                        }
                        else
                        {
                            <RadzenChart>
                                <RadzenColumnSeries CategoryProperty="Name"
                                                    Data="@ViewModel.AccompanyingFileStatus"
                                                    Fills="@(new List<string> { "#429AD5", "#071952" })"
                                                    Title="@IndexLabels.OnHold"
                                                    ValueProperty="HorizontalAxisValue">
                                    <TooltipTemplate Context="data">
                                        <div><span>@data.Name</span> : <strong>@data.HorizontalAxisValue</strong></div>
                                    </TooltipTemplate>
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="true" />
                                    </ChildContent>
                                </RadzenColumnSeries>
                                <RadzenValueAxis Min="0" Step="1" Visible="false"></RadzenValueAxis>
                                <RadzenCategoryAxis Visible="false"></RadzenCategoryAxis>
                                <RadzenColumnOptions Radius="5" Width="50" />
                                <RadzenLegend Visible="false" />
                            </RadzenChart>
                            <div>
                                <ZeeLegendElement Color="#429AD5" Label="@IndexLabels.OnHold" />
                                <ZeeLegendElement Color="#071952" Label="@IndexLabels.Completed" />
                            </div>
                        }
                    </div>
                </div>
            </AuthorizeView>
            <AuthorizeView Context="coordinators"
                           Roles="@($"{Constants.DiffuseCoordinatorRole}, {Constants.TargetedCoordinatorRole}")">
                <div class="grid-coordinators">
                    <p class="progress-title kpi-title">@IndexLabels.Progress</p>
                    <div class="card card-height break-down-file-status">
                        <h2 class="text-alignement">@IndexLabels.BreakdownFilesStatus</h2>
                        @if (Array.TrueForAll(ViewModel.AccompanyingFileStage, x => x.VerticalAxisValue <= 0))
                        {
                            <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                        }
                        else
                        {
                            <RadzenChart>
                                <RadzenColumnSeries CategoryProperty="Name"
                                                    Data="@ViewModel.AccompanyingFileStage"
                                                    Fills="@(new List<string> { "#429AD5", "orange", "grey", "cyan" })"
                                                    ValueProperty="VerticalAxisValue">
                                    <TooltipTemplate Context="data">
                                        <div><span>@data.Name</span> : <strong>@data.VerticalAxisValue</strong></div>
                                    </TooltipTemplate>
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="true" />
                                    </ChildContent>
                                </RadzenColumnSeries>
                                <RadzenColumnOptions Radius="5" Width="50" />
                                <RadzenValueAxis Min="0" Step="1" Visible="false"></RadzenValueAxis>
                                <RadzenCategoryAxis Visible="false"></RadzenCategoryAxis>
                                <RadzenLegend Visible="false" />
                            </RadzenChart>
                            <div>
                                <ZeeLegendElement Color="#429AD5" Label="@IndexLabels.MilestoneIdentification" />
                                <ZeeLegendElement Color="orange" Label="@IndexLabels.MilestoneOrganizeAndFinance" />
                                <ZeeLegendElement Color="grey" Label="@IndexLabels.MilestoneRealizeAndFollow" />
                                <ZeeLegendElement Color="cyan" Label="@IndexLabels.FinishedAccompanyingFiles" />
                            </div>
                        }
                    </div>
                    <p class="identify-title kpi-title">@IndexLabels.MilestoneIdentification</p>
                    <div class="card card-height number-household-detected">
                        <h2 class="text-alignement">@IndexLabels.NumberOfHouseholdDetected</h2>
                        @if (Array.TrueForAll(ViewModel.HouseHoldsByMarkerNatureCount, x => x.VerticalAxisValue <= 0))
                        {
                            <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                        }
                        else
                        {
                            <RadzenChart>
                                <RadzenColumnSeries CategoryProperty="Name"
                                                    Data="@ViewModel.HouseHoldsByMarkerNatureCount"
                                                    Fills="@(new List<string>
                                                                                                    {
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[0].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[1].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[2].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[3].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[4].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[5].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[6].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[7].Color!.Value.Name,
                                                                                                        ViewModel.HouseHoldsByMarkerNatureCount[8].Color!.Value.Name
                                                                                                    })"
                                            ValueProperty="VerticalAxisValue">
                            <TooltipTemplate Context="data">
                                <div><span>@data.Name</span> : <strong>@data.VerticalAxisValue</strong></div>
                            </TooltipTemplate>
                            <ChildContent>
                                <RadzenSeriesDataLabels Visible="true" />
                            </ChildContent>
                        </RadzenColumnSeries>
                        <RadzenColumnOptions Radius="5" />
                        <RadzenLegend Visible="false" />
                        <RadzenValueAxis Min="0" Step="1" Visible="false"></RadzenValueAxis>
                        <RadzenCategoryAxis Visible="false"></RadzenCategoryAxis>
                    </RadzenChart>
                    <div>
                        @foreach (var houseHoldsByMarkerNature in ViewModel.HouseHoldsByMarkerNatureCount)
                                {
                                    <div class="flex-row">
                                        <ZeeLegendElement Color="@houseHoldsByMarkerNature.Color!.Value.Name"
                                                          Label="@houseHoldsByMarkerNature.Name"></ZeeLegendElement>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <div class="card text-alignement card-height houselhold-caracteristics">
                        <h2>@IndexLabels.HouseholdCaracteristics</h2>
                        <div>
                            @if (Array.TrueForAll(ViewModel.HouseholdTypology, x => x.HorizontalAxisValue <= 0))
                            {
                                <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                            }
                            else
                            {
                                <RadzenChart>
                                    <RadzenColumnSeries Data="@ViewModel.HouseholdTypology"
                                                        CategoryProperty="Name"
                                                        ValueProperty="HorizontalAxisvalue"
                                                        Fills="@(new List<string>
                                                                                                            {
                                                                                                                "#429AD5",
                                                                                                                "#071952",
                                                                                                                "#FFA500",
                                                                                                                "#FF0000",
                                                                                                                "#00FF00",
                                                                                                                "#0000FF"
                                                                                                            })">
                                <TooltipTemplate Context="data">
                                    <div>
                                        <span>@data.Name</span> : <strong>@data.HorizontalAxisValue</strong>
                                    </div>
                                </TooltipTemplate>
                                <ChildContent>
                                    <RadzenSeriesDataLabels Visible="true" />
                                </ChildContent>
                            </RadzenColumnSeries>
                            <RadzenColumnOptions Radius="5" />
                            <RadzenValueAxis Min="0" Step="1" Visible="false"></RadzenValueAxis>
                            <RadzenCategoryAxis Visible="false"></RadzenCategoryAxis>
                            <RadzenLegend Visible="false"></RadzenLegend>
                        </RadzenChart>
                        <div>
                            <ZeeLegendElement Color="#429AD5"
                                              Label="@HouseholdTypologyLabel.CoupleWithAdultStaying" />
                            <ZeeLegendElement Color="#071952"
                                              Label="@HouseholdTypologyLabel.CoupleWithChildren" />
                            <ZeeLegendElement Color="#FFA500"
                                              Label="@HouseholdTypologyLabel.CoupleWithoutChildren" />
                            <ZeeLegendElement Color="#FF0000"
                                              Label="@HouseholdTypologyLabel.SingleParentFamily" />
                            <ZeeLegendElement Color="#00FF00" Label="@HouseholdTypologyLabel.SinglePerson" />
                            <ZeeLegendElement Color="#0000FF"
                                              Label="@HouseholdTypologyLabel.SinglePersonWithAdultStaying" />
                        </div>
                                                }
                            <h3>@IndexLabels.NumberHouseholdIdentifiedByTypology</h3>
                        </div>
                        <div class="indicator-card">
                            <div class="card-characteristic">
                                <h3 class="average-money-text">@($"{ViewModel.AverageAgeMainOccupant.ToString("N1", CultureInfo.CreateSpecificCulture("fr-FR"))}")</h3>
                                <p>@IndexLabels.AverageAgeMainOccupant</p>
                            </div>
                        </div>
                        <div class="m-3">
                            @if (Array.TrueForAll(ViewModel.SocioProfessionalCategoryRepartition, x => x.PieAxisValue <= 0))
                            {
                                <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                            }
                            else
                            {
                                <RadzenChart>
                                    <RadzenPieSeries CategoryProperty="Name"
                                                     Data="@ViewModel.SocioProfessionalCategoryRepartition"
                                                     Title="@IndexLabels.PieChartTitle"
                                                     Fills="@(new List<string>
                                                                                                         {
                                                                                                             "#429AD5",
                                                                                                             "#071952",
                                                                                                             "#FFA500",
                                                                                                             "#FF0000",
                                                                                                             "#00FF00",
                                                                                                             "#0000FF",
                                                                                                             "#0FA0FF",
                                                                                                             "#FF00FF",
                                                                                                             "#00FFFF"
                                                                                                         })"
                                             ValueProperty="PieAxisValue">
                                <RadzenSeriesDataLabels Visible=true></RadzenSeriesDataLabels>
                            </RadzenPieSeries>
                            <RadzenValueAxis Formatter="@ToPercentageSocioProfessionalCategory"></RadzenValueAxis>
                            <RadzenLegend Visible="false"></RadzenLegend>
                        </RadzenChart>
                        <div>
                            <ZeeLegendElement Color="#429AD5" Label="@SocioProfessionalCategoryLabel.Farmer" />
                            <ZeeLegendElement Color="#071952" Label="@SocioProfessionalCategoryLabel.Artisan" />
                            <ZeeLegendElement Color="#FFA500" Label="@SocioProfessionalCategoryLabel.Cadre" />
                            <ZeeLegendElement Color="#FF0000" Label="@SocioProfessionalCategoryLabel.Employee" />
                            <ZeeLegendElement Color="#00FF00"
                                              Label="@SocioProfessionalCategoryLabel.SearchingJob" />
                            <ZeeLegendElement Color="#0000FF" Label="@SocioProfessionalCategoryLabel.Worker" />
                            <ZeeLegendElement Color="#0FA0FF"
                                              Label="@SocioProfessionalCategoryLabel.IntermediateProfession" />
                            <ZeeLegendElement Color="#FF00FF" Label="@SocioProfessionalCategoryLabel.Retired" />
                            <ZeeLegendElement Color="#00FFFF"
                                              Label="@SocioProfessionalCategoryLabel.Unemployed" />
                        </div>
                                                }
                            <h3>@IndexLabels.NumberHouseholdIdentifiedBySocioProfessionalCategory</h3>
                        </div>
                    </div>
                    <div class="card card-height household-earnings text-alignement">
                        <h2>@IndexLabels.HouseholdEarnings</h2>
                        <div>
                            @if (Array.TrueForAll(ViewModel.AnahCategoryRepartition, x => x.PieAxisValue <= 0))
                            {
                                <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                            }
                            else
                            {
                                <RadzenChart>
                                    <RadzenPieSeries CategoryProperty="Name"
                                                     Data="@ViewModel.AnahCategoryRepartition"
                                                     Fills="@(new List<string> { "#429AD5", "grey" })"
                                                     Title="@IndexLabels.PieChartTitle"
                                                     ValueProperty="PieAxisValue">
                                        <RadzenSeriesDataLabels Visible=true></RadzenSeriesDataLabels>
                                    </RadzenPieSeries>
                                    <RadzenValueAxis Formatter="@ToPercentageAnnahCategory"></RadzenValueAxis>
                                    <RadzenLegend Visible="false" />
                                </RadzenChart>
                                <div>
                                    <ZeeLegendElement Color="#429AD5" Label="@Labels.LowIncomeHouseholdsAmount" />
                                    <ZeeLegendElement Color="grey" Label="@Labels.VeryLowIncomeHouseholdsAmount" />
                                </div>
                            }
                            <h4>@IndexLabels.AnahCategoriesRepartition</h4>
                        </div>
                        <div class="indicator-card text-section-alignment">
                            <h3 class="average-money-text">@($"{ViewModel.AverageTaxRevenue.ToString("C1", CultureInfo.CreateSpecificCulture("fr-FR"))}")</h3>
                            <p>@IndexLabels.TaxRevenueAverageByYear</p>
                        </div>
                    </div>
                    <div class="card card-height housing-type-households-number">
                        <h2 class="text-alignement">@IndexLabels.HousingTypeByHouseholdsNumber</h2>
                        @if (Array.TrueForAll(ViewModel.OwnershipStatusRepartition, x => x.PieAxisValue <= 0))
                        {
                            <p class="no-relevent-data">@IndexLabels.NoRelevantDataFound</p>
                        }
                        else
                        {
                            <RadzenChart>
                                <RadzenPieSeries CategoryProperty="Name"
                                                 Data="@ViewModel.OwnershipStatusRepartition"
                                                 Fills="@(new List<string> { "#429AD5", "grey", "yellow" })"
                                                 ValueProperty="PieAxisValue">
                                    <TooltipTemplate Context="data">
                                        <div><span>@data.Name</span> : <strong>@data.PieAxisValue</strong></div>
                                    </TooltipTemplate>
                                    <ChildContent>
                                        <RadzenSeriesDataLabels Visible="true" />
                                    </ChildContent>
                                </RadzenPieSeries>
                                <RadzenValueAxis Formatter="@ToPercentageOwnershipStatus"></RadzenValueAxis>
                                <RadzenLegend Visible="false" />
                            </RadzenChart>
                            <div>
                                <ZeeLegendElement Color="#429AD5" Label="@OwnershipStatusLabel.FullOwnership" />
                                <ZeeLegendElement Color="grey" Label="@OwnershipStatusLabel.CoOwner" />
                                <ZeeLegendElement Color="yellow" Label="@OwnershipStatusLabel.JointOwnership" />
                            </div>
                        }
                    </div>
                    <div class="card card-height before-work-energy text-alignement">
                        <h2>@IndexLabels.BeforeWorksEnergy</h2>
                        <div class="indicator-card">
                            <div class="card-characteristic">
                                <h3 class="average-money-text">@($"{ViewModel.AverageEnergyEffortBeforeWork.ToString("P1")}")</h3>
                                <p>@IndexLabels.AverageEnergyEffortBeforeWork</p>
                            </div>
                        </div>
                        <div class="card-characteristic indicator-card">
                            <h3 class="average-money-text">@ViewModel.AverageDeprivationRate.ToString("P1")</h3>
                            <p>@IndexLabels.HouseholdInTotalEnergyDeprivation</p>
                        </div>
                        <div>
                            <h3>@IndexLabels.NumberHouseholdIdentifiedByEnergeticsLabels</h3>
                            <DpeChart Data="@ViewModel.HouseHoldsByInitialDpe" />
                        </div>
                    </div>
                    <div class="card card-height average-delivery-time text-alignement">
                        <h2>@IndexLabels.AverageDeliveryTimeTitle</h2>
                        <div class="indicator-card">
                            <div class="card-characteristic">
