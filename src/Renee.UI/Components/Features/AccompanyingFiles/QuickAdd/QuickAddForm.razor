@using Renee.Application.DTOs.Occupant
@using Renee.Application.Helpers
@using Renee.Domain.Enums
@using Renee.UI.Components.ErrorHandling
@attribute [Route(Endpoints.QuickAddAccompanyingFile)]
@attribute [Authorize]

<AuthorizeView Context="_"
               Roles="@($"{Constants.SolidarBuilderRole}, {Constants.TerritorialBuilderRole}, {Constants.DiffuseCoordinatorRole}, {Constants.TargetedCoordinatorRole}, {Constants.StructuralReferentRole}")">
    <Authorized>
        <ZeeHeader ShouldRenderLogo="false"
                   Title="@Labels.QuickAddAccompanyingFile">
        </ZeeHeader>

        <EditForm EditContext="_quickAddEditContext"
                  OnValidSubmit="OnValidSubmit">

            <ObjectGraphDataAnnotationsValidator />

            <div class="grid-container">
                <div class="card-1">
                    <div class="card grid-form"
                         style="margin-bottom: 26px;">
                        <div>
                            <h4 class="section-title">@Labels.MainOccupant</h4>
                        </div>

                        <OutlinedText EditContext="_quickAddEditContext"
                                      FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.LastName)"
                                      IsInForm="false"
                                      IsRequired
                                      Label="@Labels.Name"
                                      @bind-Value="@QuickAddFormViewModel.LastName" />
                        <ValidationMessage For="@(() => QuickAddFormViewModel.LastName)" />

                        <OutlinedText EditContext="_quickAddEditContext"
                                      FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.FirstName)"
                                      IsInForm="false"
                                      IsRequired
                                      Label="@Labels.FirstName"
                                      @bind-Value="@QuickAddFormViewModel.FirstName" />
                        <ValidationMessage For="@(() => QuickAddFormViewModel.FirstName)" />

                        <label>@Labels.PhoneNumberOccupant</label>
                        <div>
                            <ZeePhoneNumber @bind-BindingValue="QuickAddFormViewModel.PhoneNumber"
                                            Class="form-control">
                            </ZeePhoneNumber>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.PhoneNumber)" />
                        </div>

                        <div>
                            <OutlinedText @bind-Value="QuickAddFormViewModel.Email"
                                          EditContext="_quickAddEditContext"
                                          FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.Email)"
                                          IsInForm="false"
                                          IsRequired="false"
                                          Label="@Labels.EmailOccupant">
                            </OutlinedText>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.Email)" />
                        </div>
                    </div>

                    <div class="card grid-form">
                        <h4 class="section-title">@Labels.PropertyType</h4>
                        <div>
                            @if (PropertyTypes != null)
                            {
                                <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.AskedPropertyType"
                                           EditContext="_quickAddEditContext"
                                           ElementName="@($"propertytype-{Guid.NewGuid().ToString()}")"
                                           FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AskedPropertyType)"
                                           Items="@PropertyTypes" OnNewValueSelected="OnPropertyTypeChanged" TItem="HousingType?"
                                           ShouldSort="true">
                                </ZeeSelect>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.AskedPropertyType)" />
                            }
                        </div>

                        @if (ShouldDisplayCopropertyAttachmentField)
                        {
                            <label>
                                @Labels.CopropertyAttachment
                            </label>
                            <div>
                                <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.CopropertyProfileId"
                                           EditContext="_quickAddEditContext"
                                           ElementName="@($"copropertyprofile-{Guid.NewGuid().ToString()}")"
                                           FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.CopropertyProfileId)"
                                           Items="@CopropertyProfiles" TItem="Guid?"
                                           ShouldSort="true">
                                </ZeeSelect>
                            </div>
                        }
                    </div>

                    <div class="card grid-form">
                        <div>
                            <h4 class="section-title">@Labels.Address</h4>
                        </div>

                        <div class="manual-address">
                            <ZeeToggle @bind-Value="IsCustomAddress"
                                       DisplayBackground="DisplayEnumBackground.Blue"
                                       IsTextPresent="false">
                            </ZeeToggle>
                            <span>@Labels.ManualAddress</span>
                        </div>

                        @if (IsCustomAddress == false)
                        {
                            <label class="required">@Labels.StreetNumberName</label>
                            <div>
                                <RadzenDropDown AllowFiltering="true"
                                                @bind-Value="QuickAddFormViewModel.StreetNumberName"
                                                Count="20"
                                                Data="AddressList"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                LoadData="@LoadAddresses"
                                                Multiple="false"
                                                Placeholder="@Labels.DropDownPlaceholder"
                                                Style="width: 100%"
                                                TextProperty="Label"
                                                TValue="AddressDto">
                                </RadzenDropDown>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.StreetNumberName)" />
                            </div>
                        }
                        else
                        {
                            <div>
                                <OutlinedText @bind-Value="QuickAddFormViewModel.ManualAddressName"
                                              EditContext="_quickAddEditContext"
                                              FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.ManualAddressName)"
                                              IsInForm="false"
                                              IsRequired=true
                                              Label="@Labels.StreetNumberName">
                                </OutlinedText>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.ManualAddressName)" />
                            </div>
                        }

                        <div>
                            <OutlinedText @bind-Value="QuickAddFormViewModel.AdditionalAddress"
                                          EditContext="_quickAddEditContext"
                                          FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AdditionalAddress)"
                                          IsInForm="false"
                                          IsRequired="false"
                                          Label="@Labels.AdditionalAddress">
                            </OutlinedText>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.AdditionalAddress)" />
                        </div>

                        <div>
                            <OutlinedText @bind-Value="QuickAddFormViewModel.PostalCode"
                                          EditContext="_quickAddEditContext"
                                          FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.PostalCode)"
                                          IsInForm="false"
                                          IsRequired="true"
                                          disabled="@(!IsCustomAddress)"
                                          Label="@Labels.PostalCode">
                            </OutlinedText>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.PostalCode)" />
                        </div>

                        <div>
                            <OutlinedText @bind-Value="QuickAddFormViewModel.Municipality"
                                          EditContext="_quickAddEditContext"
                                          FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.Municipality)"
                                          IsInForm="false"
                                          IsRequired="true"
                                          disabled="@(!IsCustomAddress)"
                                          Label="@Labels.Municipality">
                            </OutlinedText>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.Municipality)" />
                        </div>

                        <div>
                            <OutlinedText @bind-Value="QuickAddFormViewModel.Department"
                                          EditContext="_quickAddEditContext"
                                          FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.Department)"
                                          IsInForm="false"
                                          IsRequired="true"
                                          disabled="@(!IsCustomAddress)"
                                          Label="@Labels.Department">
                            </OutlinedText>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.Department)" />
                        </div>

                        <div>
                            <OutlinedText @bind-Value="QuickAddFormViewModel.Region"
                                          EditContext="_quickAddEditContext"
                                          FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.Region)"
                                          IsInForm="false"
                                          IsRequired="true"
                                          disabled="@(!IsCustomAddress)"
                                          Label="@Labels.Region">
                            </OutlinedText>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.Region)" />
                        </div>

                        <div>
                            <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.Typology"
                                    ElementName="@($"typology-{Guid.NewGuid().ToString()}")"
                                    FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.Typology)"
                                    IsRequired="true"
                                    Items="@ItemsList.GeographicalTypologies"
                                    Label="@Labels.Typology"
                                    TItem="GeographicalHousingAreaTypology?">
                            </ZeeSelect>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.Typology)" />
                        </div>
                    </div>
                </div>

                <div class="card card-2 flex-form">
                    <div>
                        <h4 class="section-title">@Labels.Accompaniement</h4>
                    </div>

                    <div>
                        <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.AccompaniementViewModel.MarkerNature"
                                EditContext="@_quickAddEditContext"
                                ElementName="@($"marker-nature-{Guid.NewGuid().ToString()}")"
                                FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.MarkerNature)"
                                IsRequired="true"
                                Items="@ItemsList.MarkerNature"
                                Label="@Labels.MarkerNature"
                                OnNewValueSelected="@OnMarkerNatureChanged"
                                TItem="MarkerNature?"
                                ShouldSort="true">
                        </ZeeSelect>
                        <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.MarkerNature)" />
                    </div>

                    @if (QuickAddFormViewModel.AccompaniementViewModel.MarkerNature is not null && QuickAddFormViewModel.AccompaniementViewModel.MarkerNature == Domain.Enums.MarkerNature.Other)
                    {
                        <OutlinedText @bind-Value="@QuickAddFormViewModel.AccompaniementViewModel.CommentOnMarkerNature"
                                    EditContext="@_quickAddEditContext"
                                    FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.CommentOnMarkerNature)"
                                    IsRequired="true"
                                    Label="@Labels.Other">
                        </OutlinedText>
                        <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.CommentOnMarkerNature)" />
                    }

                    <div>
                        <h4 class="section-title">@Labels.TrustedTier</h4>
                    </div>

                    <div class="trusted-tier-fields">
                        <div>
                            <OutlinedText @bind-Value="@QuickAddFormViewModel.AccompaniementViewModel.TrustedTierStructureName"
                                        EditContext="_quickAddEditContext"
                                        FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierStructureName)"
                                        Label="@Labels.TrustedTierStructureName">
                            </OutlinedText>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierStructureName)" />
                        </div>
                    </div>

                    <div>
                        <div>
                            <div>
                                <OutlinedText @bind-Value="@QuickAddFormViewModel.AccompaniementViewModel.TrustedTierLastName"
                                            EditContext="_quickAddEditContext"
                                            FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierLastName)"
                                            Label="@Labels.TrustedTierLastName">
                                </OutlinedText>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierLastName)" />
                            </div>

                            <div>
                                <OutlinedText @bind-Value="@QuickAddFormViewModel.AccompaniementViewModel.TrustedTierFirstName"
                                            EditContext="_quickAddEditContext"
                                            FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierFirstName)"
                                            Label="@Labels.TrustedTierFirstName">
                                </OutlinedText>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierFirstName)" />
                            </div>

                            <label>
                                @Labels.TrustedTierPhoneNumber
                            </label>

                            <div>
                                <ZeePhoneNumber @bind-BindingValue="@QuickAddFormViewModel.AccompaniementViewModel.TrustedTierPhoneNumber"
                                                Class="form-control">
                                </ZeePhoneNumber>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierPhoneNumber)" />
                            </div>

                            <div>
                                <OutlinedText @bind-Value="@QuickAddFormViewModel.AccompaniementViewModel.TrustedTierEmail"
                                            EditContext="_quickAddEditContext"
                                            FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierEmail)"
                                            IsRequired="false"
                                            Label="@Labels.TrustedTierEmail">
                                </OutlinedText>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierEmail)" />
                            </div>

                            <div>
                                <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.AccompaniementViewModel.TrustedTierRole"
                                        EditContext="@_quickAddEditContext"
                                        ElementName="@($"trustedthirdpartyrole-{Guid.NewGuid().ToString()}")"
                                        FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierRole)"
                                        IsRequired="false"
                                        Items="@ItemsList.TrustedTierRoles"
                                        Label="@Labels.TrustedTierRole"
                                        TItem="TrustedTierRole?"
                                        ShouldSort="true">
                                </ZeeSelect>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierRole)" />
                            </div>

                            @if (QuickAddFormViewModel.AccompaniementViewModel.TrustedTierRole == TrustedTierRole.Other)
                            {
                                <div>
                                    <OutlinedText @bind-Value="@QuickAddFormViewModel.AccompaniementViewModel.TrustedTierRoleFreeInput"
                                                EditContext="_quickAddEditContext"
                                                FieldIdentifier="@FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierRoleFreeInput)"
                                                IsInForm=true
                                                IsRequired=false
                                                Label="@Labels.TrustedTierAskedRole">
                                    </OutlinedText>
                                    <ValidationMessage For="@(() => QuickAddFormViewModel.AccompaniementViewModel.TrustedTierRoleFreeInput)" />
                                </div>
                            }
                        </div>
                    </div>

                    <div>
                        <div>
                            <ZeeSelect @bind-CheckedValue="QuickAddFormViewModel.ZeroEnergyExclusionTerritoriesProgram"
                                    EditContext="@_quickAddEditContext"
                                    ElementName="@($"ZeroEnergyExclusionTerritoriesProgram-{Guid.NewGuid().ToString()}")"
                                    FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.ZeroEnergyExclusionTerritoriesProgram)"
                                    IsRequired="true"
                                    Items="@ItemsList.NullableYesNoList"
                                    Label="@Labels.ZeroEnergyExclusionTerritoriesProgram"
                                    OnNewValueSelected="OnAccompanyingTypeChanged"
                                    ShowLabelBefore="true"
                                    TItem="bool?" />
                        </div>
                        <ValidationMessage For="@(() => QuickAddFormViewModel.ZeroEnergyExclusionTerritoriesProgram)" />
                    </div>

                    @if (QuickAddFormViewModel.ZeroEnergyExclusionTerritoriesProgram == true)
                    {
                        <div>
                            <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.AccompanyingType"
                                    EditContext="@_quickAddEditContext"
                                    ElementName="@($"AccompanyingType-{Guid.NewGuid().ToString()}")"
                                    FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.AccompanyingType)"
                                    IsRequired="true"
                                    Items="@ItemsList.AccompanyingTypes"
                                    Label="@Labels.AccompanyingType"
                                    OnNewValueSelected="OnAccompanyingTypeChanged"
                                    TItem="AccompanyingType?">
                            </ZeeSelect>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.AccompanyingType)" />
                        </div>

                        @if (QuickAddFormViewModel.AccompanyingType == AccompanyingType.Diffuse)
                        {
                            <div>
                                <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.ReferentDiffuseCoordinator"
                                        EditContext="@_quickAddEditContext"
                                        ElementName="@($"DiffuseCoordiator-{Guid.NewGuid().ToString()}")"
                                        FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.ReferentDiffuseCoordinator)"
                                        IsRequired="true"
                                        Items="@DiffuseCoordinatorUsers"
                                        Label="@Labels.ReferentDiffuseCoordinator"
                                        TItem="Guid?"
                                        ShouldSort="true">
                                </ZeeSelect>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.ReferentDiffuseCoordinator)" />
                            </div>
                        }

                        @if (QuickAddFormViewModel.AccompanyingType == AccompanyingType.Targeted)
                        {
                            <div>
                                <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.ReferentTargetCoordinator"
                                        EditContext="@_quickAddEditContext"
                                        ElementName="@($"TargetCoordinator-{Guid.NewGuid().ToString()}")"
                                        FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.ReferentTargetCoordinator)"
                                        IsRequired="true"
                                        Items="@TargetCoordinator"
                                        Label="@Labels.ReferentTargetedCoordinator"
                                        ShowLabelBefore="true"
                                        TItem="Guid?"
                                        ShouldSort="true">
                                </ZeeSelect>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.ReferentTargetCoordinator)" />
                            </div>

                            @if (TerritorialBuilderUsers != null)
                            {
                                <div>
                                    <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.ReferentEtId"
                                            EditContext="@_quickAddEditContext"
                                            ElementName="@($"referent-et-{Guid.NewGuid().ToString()}")"
                                            FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.ReferentEtId)"
                                            IsRequired="true"
                                            Items="@TerritorialBuilderUsers"
                                            Label="@Labels.ReferentEt"
                                            ShowLabelBefore="true"
                                            TItem="Guid?"
                                            ShouldSort="true">
                                    </ZeeSelect>
                                    <ValidationMessage For="@(() => QuickAddFormViewModel.ReferentEtId)" />

                                </div>
                                <div>
                                    <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.SecondReferentEtId"
                                            EditContext="@_quickAddEditContext"
                                            ElementName="@($"referent-et-{Guid.NewGuid().ToString()}")"
                                            FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.SecondReferentEtId)"
                                            Items="@TerritorialBuilderUsers"
                                            Label="@Labels.SecondReferentEt"
                                            ShowLabelBefore="true"
                                            TItem="Guid?"
                                            ShouldSort="true">
                                    </ZeeSelect>
                                </div>
                            }


                            <div>
                                <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.Territory"
                                        EditContext="@_quickAddEditContext"
                                        ElementName="@($"Territory-{Guid.NewGuid().ToString()}")"
                                        FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.Territory)"
                                        IsRequired="true"
                                        Items="@Territory"
                                        Label="@Labels.Territory"
                                        ShowLabelBefore="true"
                                        TItem="Guid?"
                                        ShouldSort="true">
                                </ZeeSelect>
                                <ValidationMessage For="@(() => QuickAddFormViewModel.Territory)" />
                            </div>
                        }
                    }

                    <div>
                        <h4 class="section-title">
                            @Labels.ReferentSolidarBuilder
                            <span class="required"></span>
                        </h4>
                    </div>
                    <div>
                        @if (SolidarBuilderUsers != null)
                        {
                            <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.ReferentSolidarBuilderId"
                                    EditContext="@_quickAddEditContext"
                                    ElementName="@($"referent-es-{Guid.NewGuid().ToString()}")"
                                    FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.ReferentSolidarBuilderId)"
                                    IsRequired="true"
                                    Items="@SolidarBuilderUsers"
                                    Label="@Labels.ReferentSolidarBuilder"
                                    ShowLabelBefore="false"
                                    TItem="Guid?"
                                    ShouldSort="true">
                            </ZeeSelect>
                            <ValidationMessage For="@(() => QuickAddFormViewModel.ReferentSolidarBuilderId)" />
                        }
                    </div>

                    <div>
                        <h4 class="section-title">
                            @Labels.SecondReferentSolidarBuilder
                        </h4>
                    </div>

                    <div>
                        @if (SolidarBuilderUsers != null)
                        {
                            <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.SecondReferentSolidarBuilderId"
                                    EditContext="@_quickAddEditContext"
                                    ElementName="@($"second-referent-es-{Guid.NewGuid().ToString()}")"
                                    FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.SecondReferentSolidarBuilderId)"
                                    IsRequired="false"
                                    Items="@SolidarBuilderUsers"
                                    Label="@Labels.SecondReferentSolidarBuilder"
                                    ShowLabelBefore="false"
                                    TItem="Guid?"
                                    ShouldSort="true">
                            </ZeeSelect>
                        }
                    </div>

                    <div>
                        <h4 class="section-title">
                            @Labels.ThirdReferentSolidarBuilderQuickAddLabel
                        </h4>
                    </div>

                    <div>
                        @if (SolidarBuilderUsers != null)
                        {
                            <ZeeSelect @bind-CheckedValue="@QuickAddFormViewModel.ThirdReferentSolidarBuilderId"
                                    EditContext="@_quickAddEditContext"
                                    ElementName="@($"second-referent-es-{Guid.NewGuid().ToString()}")"
                                    FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => QuickAddFormViewModel.ThirdReferentSolidarBuilderId)"
                                    IsRequired="false"
                                    Items="@SolidarBuilderUsers"
                                    Label="@Labels.ThirdReferentSolidarBuilder"
                                    ShowLabelBefore="false"
                                    TItem="Guid?"
                                    ShouldSort="true">
                            </ZeeSelect>
                        }
                    </div>
                </div>

                <div class="zeeButton">
                    <ZeeButton IsSubmit="true"
                            Text="@Labels.Submit">
                    </ZeeButton>
                </div>
            </div>
        </EditForm>
    </Authorized>

    <NotAuthorized>
        <ErrorPage />
    </NotAuthorized>
</AuthorizeView>