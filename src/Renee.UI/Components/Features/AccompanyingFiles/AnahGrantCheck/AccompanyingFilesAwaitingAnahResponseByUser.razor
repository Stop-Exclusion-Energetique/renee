@using Renee.Application.Queries.AccompanyingFile
@using Renee.Domain
@using Renee.UI.Components.ErrorHandling
@using Radzen
@using Radzen.Blazor

@attribute [Route(Endpoints.AnahGrantCheck)]
@attribute [Authorize]

<AuthorizeView Context="_"
               Policy="AnahGrantCheckAccessPolicy">
    <Authorized>
        <div class="content anah-notification">
        <div class="header bg-warning text-white">
            <h4 class="title">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @Labels.BlockingPopupAnahCheckTitle
            </h4>
        </div>

        <div class="body">
            <p class="alert alert-warning mb-4">
                @(string.Format(Labels.BlockingPopupAnahCheckText, AccompanyingFilesAwaitingAnahResponse.Count))
            </p>

            <ZeeDataGrid @ref="grid"
                         Data="@AccompanyingFilesAwaitingAnahResponse"
                         TItem="AccompanyingFileAwaitingAnahResponseResume"
                         AllowFiltering="false"
                         AllowPaging="false"
                         AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="AccompanyingFileAwaitingAnahResponseResume"
                                          Property="Reference"
                                          Title="Référence">
                        <Template Context="data">
                            <strong class="text-primary">@data.AccompanyingFileReference</strong>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="AccompanyingFileAwaitingAnahResponseResume"
                                          Title="Nom de l'occupant"
                                          Sortable="false">
                        <Template Context="data">
                            @data.OccupantFullName
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="AccompanyingFileAwaitingAnahResponseResume"
                                          Property="HousingAddressLabel"
                                          Title="Adresse">
                        <Template Context="data">
                            <small class="text-muted">@data.HousingAddress</small>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="AccompanyingFileAwaitingAnahResponseResume"
                                          Title="Statut d'octroi ANAH"
                                          Sortable="false">

                        <Template Context="data">
                            <div class="d-flex flex-column gap-2">
                                <ZeeSelect @bind-CheckedValue="@AccompanyingFilesGrantStatuses[data.AccompanyingFileId]"
                                           ElementName="@($"GrantStatuses-{Guid.NewGuid().ToString()}")"
                                           OnNewValueSelected="@(() => OnGrantStatusChanged(data.AccompanyingFileId))"
                                           Items="_grantStatusesOptions"
                                           TItem="bool?" />

                                @if (AccompanyingFilesGrantStatuses[data.AccompanyingFileId] is true)
                                {
                                    <div class="date-picker-container">
                                        <RadzenDatePicker @bind-Value="@AccompanyingFilesGrantDates[data.AccompanyingFileId]"
                                                          DateFormat="dd/MM/yyyy"
                                                          Placeholder="@RealiseAndFollowMilestone.Labels.AnahGrantDate"
                                                          Max="@DateTime.Today"
                                                          ShowTime="false"
                                                          Style="width: 100%;"
                                                          class="@(!IsRowValid(data.AccompanyingFileId) ? "rz-invalid" : "")" />
                                    </div>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </ZeeDataGrid>
        </div>

        <div class="footer bg-light">
            <div class="d-flex justify-content-between align-items-center w-100">
                <ZeeButton DisplayBackground="DisplayEnumBackground.Green"
                           disabled="@(!CanSubmit)"
                           Text="@Labels.ValidateAndClose"
                           @onclick="@ValidateAndClose" />
            </div>
        </div>
    </div>
    </Authorized>

    <NotAuthorized>
        <ErrorPage />
    </NotAuthorized>
</AuthorizeView>