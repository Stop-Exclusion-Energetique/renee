@using Renee.Application.Helpers
@using Renee.Domain.Enums
<div>
	<div class="card flex-container">
		<h4 class="section-title">
			@Labels.EnergyCharacteristics
		</h4>

		<div class="grid-form">
			<div class="d-flex"
			     style="flex-direction: column;">
				<label class="required">
					@Labels.HouseEtiquette
				</label>
				<div class="d-flex"
				     style="flex-direction: column; gap: 1em;">
					<div>
						<ZeeSelectDpe @bind-CheckedValue="@ViewModel.AskedDpeLabel"
						              EditContext="_editContext"
						              ElementName="@($"dpe-{Guid.NewGuid().ToString()}")"
						              FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => ViewModel.AskedDpeLabel)"
						              Items="@ItemsList.DpeLabels"/>

						<ValidationMessage For="@(() => ViewModel.AskedDpeLabel)"/>
					</div>

					<div>
						<OutlinedDouble @bind-Double="@ViewModel.EnergyConsumption"
						                EditContext="_editContext"
						                FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => ViewModel.EnergyConsumption)"
						                Label="@Labels.EnergyConsumption"
						                Type="OutlinedDouble.TypeOfValue.Double"
										IsRequired="true"
										disabled="@AreCopropertyManagedEnergyFieldsDisabled">
						</OutlinedDouble>
						<ValidationMessage For="@(() => ViewModel.EnergyConsumption)"/>
					</div>
				</div>
			</div>

			<div class="d-flex"
			     style="flex-direction: column;">
				<label class="required">
					@Labels.GesEtiquette
				</label>
				<div class="d-flex"
				     style="flex-direction: column; gap: 1em;">
					<div>
						<ZeeSelectGes @bind-CheckedValue="@ViewModel.AskedGesLabel"
						              EditContext="_editContext"
						              ElementName="@($"ges-{Guid.NewGuid().ToString()}")"
						              FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => ViewModel.AskedGesLabel)"
						              Items="@ItemsList.GesLabels"
									  disabled="@(IsUserAllowedToEdit || IsSoliha)" />

						<ValidationMessage For="@(() => ViewModel.AskedGesLabel)"/>
					</div>
					<div>
						<OutlinedDouble @bind-Double="@ViewModel.GesEmissions"
						                EditContext="_editContext"
						                FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => ViewModel.GesEmissions)"
						                Label="@Labels.GesEmissions"
						                Type="OutlinedDouble.TypeOfValue.Double"
										disabled="@(IsUserAllowedToEdit || IsSoliha)">
						</OutlinedDouble>
						<ValidationMessage For="@(() => ViewModel.GesEmissions)"/>
					</div>
				</div>
			</div>

			<div>
				<div class="item-civility">
                    <div class="item-civility">
                        <ZeeToolTip InfoBullMessage="@Labels.EnergyDeprivationTootltip"
                                    InfoBullTitle="@Labels.EnergyDeprivation" />
						<ZeeSelect @bind-CheckedValue="ViewModel.EnergyDeprivation"
						           EditContext="_editContext"
								   ElementName="@($"EnergyDeprivation-{Guid.NewGuid().ToString()}")"
						           FieldIdentifier="FieldIdentifierHelper.GetFieldIdentifierForProperty(() => ViewModel.EnergyDeprivation)"
								   IsRequired="@ViewModel.IsEnergyEffortRateRequired"
						           Items="@PartialTotalList"
						           Label="@Labels.EnergyDeprivation"
						           TItem="EnergyDeprivation?"
								   IsDisabled="@IsUserAllowedToEdit"
								   >
						</ZeeSelect>
						<ValidationMessage For="@(() => ViewModel.EnergyDeprivation)" />
					</div>
				</div>
			</div>

		</div>
	</div>
</div>